{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pedalplayground",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "http-server",
        ".",
        "-p",
        "3000",
        "-c-1"
      ],
      "port": 3000
    },
    {
      "name": "web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "source ~/.nvm/nvm.sh && nvm use >/dev/null && npm run dev"
      ],
      "port": 5173,
      "cwd": "web"
    }
  ]
}
