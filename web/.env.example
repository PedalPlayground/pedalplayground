VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Where thumb/, img/ and catalog.json are served from. Defaults to same-origin /catalog/.
# In production, point at the CDN origin that hosts the generated catalog.
VITE_CATALOG_BASE_URL=

# Beta builds: copy .env.beta and fill in; see docs/deploy-beta.md.
# VITE_BETA=true shows a Beta badge and asks search engines not to index the site.
# VITE_FEEDBACK_URL=mailto:you@example.com
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to build without analytics.
# VITE_GA_ID=
# Affiliate Buy links in the Equipment List (Reverb via Awin). Leave off until the store approves us.
# VITE_BUY_LINKS=true
