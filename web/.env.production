# Settings for production builds (`BUILD_MODE=production ./scripts/deploy.sh`, or `npm run build`). Beta builds
# (.env.beta) have no analytics, so testing doesn't pollute the numbers. Public values only: no secrets here.
# Google Analytics 4 measurement ID.
VITE_GA_ID=G-NDDRYBYVS4
# Microsoft Clarity project ID.
VITE_CLARITY_ID=z4t9lq5ten
# Consent banner: "off" never asks (opt-out in Terms & Privacy). Set to "regional" to ask visitors in Europe before
# analytics starts, or "all" to ask everyone. Turned off for launch; revisit if Europe becomes a real share of traffic.
VITE_CONSENT=off
