# Non-secret settings for beta builds: `npm run build -- --mode beta`.
# Supabase URL/key come from .env.local, which Vite also loads in every mode.
VITE_BETA=true
# Where the "Send feedback" link goes, e.g. mailto:feedback@pedalplayground.com or a form URL.
VITE_FEEDBACK_URL=
# Like production, beta reads the catalog from /catalog/ on its own server, which the Catalog publish workflow
# copies there from Supabase. (Loading it straight from Supabase Storage ran out of database connections.)
