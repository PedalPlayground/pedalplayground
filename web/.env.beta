# Non-secret settings for beta builds: `npm run build -- --mode beta`.
# Supabase URL/key come from .env.local, which Vite also loads in every mode.
VITE_BETA=true
# Where the "Send feedback" link goes, e.g. mailto:feedback@pedalplayground.com or a form URL.
VITE_FEEDBACK_URL=
# Beta reads the catalog from Supabase (built by the Catalog publish workflow) instead of /catalog/ on the beta site.
VITE_CATALOG_BASE_URL=https://ookpbdtmqbkapzcnzstv.supabase.co/storage/v1/object/public/catalog-public/
